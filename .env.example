# ========================================================
# ZORIQ / NexMart Environment Configuration
# ========================================================

# --- Client-Side (Vite Frontend) ---
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Server-Side (Vercel Serverless Functions in /api) ---
# Supabase Project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (NEVER expose to frontend!)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Owner Security PIN (Secret PIN to log into the Merchant Portal)
ADMIN_PIN=7784

# Secret passphrase used to sign and verify Admin Session Tokens (min 32 random characters)
ADMIN_SESSION_SECRET=zoriq_secure_secret_passphrase_change_me_in_production_12345
ADMIN_JWT_SECRET=zoriq_secure_secret_passphrase_change_me_in_production_12345

# (Optional but Recommended) Razorpay Key Secret from Razorpay Dashboard
# Used to verify HMAC-SHA256 payment signatures when customers complete payment
RAZORPAY_KEY_SECRET=
